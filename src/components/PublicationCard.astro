---
interface Props {
  title: string;
  authors: string;
  journal: string;
  year: number;
  link?: string;
  abstract?: string;
}

const { title, authors, journal, year, link, abstract } = Astro.props;
---

<article class="card">
  <div class="card-body">
    <div class="flex items-center gap-2 text-sm text-text-muted mb-2">
      <span class="font-medium">{journal}</span>
      <span>&bull;</span>
      <span>{year}</span>
    </div>

    <h3 class="text-lg font-bold text-text mb-2">
      {link ? (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-primary transition-colors"
        >
          {title}
        </a>
      ) : (
        title
      )}
    </h3>

    <p class="text-sm text-text-muted mb-3">
      {authors}
    </p>

    {abstract && (
      <p class="text-text-muted text-sm mb-4 line-clamp-2">
        {abstract}
      </p>
    )}

    {link && (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center text-secondary font-medium text-sm hover:text-secondary-dark transition-colors"
      >
        Read Full Paper
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    )}
  </div>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
