---
interface Props {
  variant?: 'inline' | 'card';
  title?: string;
  description?: string;
}

const {
  variant = 'card',
  title = 'Subscribe to "Digest This!"',
  description = 'Get quarterly updates on our research, new projects, and opportunities to get involved.'
} = Astro.props;
---

{variant === 'card' ? (
  <div class="bg-gradient-to-br from-primary to-secondary rounded-xl p-8 text-white">
    <div class="max-w-xl mx-auto text-center">
      <h3 class="text-2xl font-bold mb-2">{title}</h3>
      <p class="text-white/80 mb-6">{description}</p>

      <!-- MailerLite Embedded Form -->
      <div id="mlb2-34951526" class="ml-form-embedContainer ml-subscribe-form ml-subscribe-form-34951526">
        <div class="ml-form-align-center">
          <div class="ml-form-embedWrapper embedForm" style="max-width: 400px; width: 100%; background-color: transparent; border: none;">

            <div class="ml-form-embedBody ml-form-embedBodyDefault row-form">
              <form class="ml-block-form" action="https://assets.mailerlite.com/jsonp/1997864/forms/174528320748128161/subscribe" data-code="" method="post" target="_blank">
                <div class="flex flex-col sm:flex-row gap-3">
                  <input
                    aria-label="email"
                    aria-required="true"
                    type="email"
                    name="fields[email]"
                    placeholder="Enter your email"
                    autocomplete="email"
                    required
                    class="flex-1 px-4 py-3 rounded-md text-text focus:outline-none focus:ring-2 focus:ring-accent"
                  />
                  <input type="hidden" name="ml-submit" value="1">
                  <input type="hidden" name="anticsrf" value="true">
                  <button type="submit" class="btn bg-white text-primary hover:bg-accent font-semibold">
                    Subscribe
                  </button>
                </div>
              </form>
            </div>

            <div class="ml-form-successBody row-success" style="display: none">
              <div class="text-white text-center py-4">
                <h4 class="font-bold text-lg">Thank you!</h4>
                <p>You have successfully joined our subscriber list.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <p class="text-white/60 text-sm mt-4">
        We respect your privacy. Unsubscribe at any time.
      </p>
    </div>
  </div>
) : (
  <div id="mlb2-34951526-inline" class="ml-form-embedContainer ml-subscribe-form ml-subscribe-form-34951526">
    <div class="ml-form-embedWrapper embedForm" style="max-width: 100%; width: 100%; background-color: transparent; border: none;">
      <div class="ml-form-embedBody ml-form-embedBodyDefault row-form">
        <form class="ml-block-form" action="https://assets.mailerlite.com/jsonp/1997864/forms/174528320748128161/subscribe" data-code="" method="post" target="_blank">
          <div class="flex flex-col sm:flex-row gap-3">
            <input
              aria-label="email"
              aria-required="true"
              type="email"
              name="fields[email]"
              placeholder="Enter your email"
              autocomplete="email"
              required
              class="flex-1 px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-transparent"
            />
            <input type="hidden" name="ml-submit" value="1">
            <input type="hidden" name="anticsrf" value="true">
            <button type="submit" class="btn-primary">
              Subscribe
            </button>
          </div>
        </form>
      </div>

      <div class="ml-form-successBody row-success" style="display: none">
        <div class="text-success text-center py-4">
          <h4 class="font-bold text-lg">Thank you!</h4>
          <p>You have successfully joined our subscriber list.</p>
        </div>
      </div>
    </div>
  </div>
)}

<!-- MailerLite Script -->
<script is:inline src="https://groot.mailerlite.com/js/w/webforms.min.js?v176e10baa5e7ed80d35ae235be3d5024"></script>
<script is:inline>
  function ml_webform_success_34951526() {
    var successElements = document.querySelectorAll('.ml-subscribe-form-34951526 .row-success');
    var formElements = document.querySelectorAll('.ml-subscribe-form-34951526 .row-form');
    successElements.forEach(function(el) { el.style.display = 'block'; });
    formElements.forEach(function(el) { el.style.display = 'none'; });
  }
</script>
