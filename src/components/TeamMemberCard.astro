---
interface Props {
  name: string;
  role: string;
  region?: string;
  bio?: string;
  interests?: string;
  image?: string;
}

const { name, role, region, bio, interests, image } = Astro.props;
---

<article class="card group text-center">
  <div class="p-6">
    <!-- Avatar -->
    <div class="w-32 h-32 mx-auto mb-4 rounded-full overflow-hidden bg-gray-100 ring-4 ring-accent/30">
      {image ? (
        <img
          src={image}
          alt={name}
          class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-primary to-secondary">
          <span class="text-4xl font-bold text-white">
            {name.split(' ').map(n => n[0]).join('').slice(0, 2)}
          </span>
        </div>
      )}
    </div>

    <!-- Info -->
    <h3 class="text-xl font-bold text-text mb-1">{name}</h3>
    <p class="text-secondary font-medium mb-1">{role}</p>
    {region && (
      <p class="text-sm text-text-muted mb-3">{region}</p>
    )}

    {interests && (
      <p class="text-sm text-text-muted mb-3">
        <span class="font-medium">Interests:</span> {interests}
      </p>
    )}

    {bio && (
      <p class="text-text-muted text-sm line-clamp-3">{bio}</p>
    )}
  </div>
</article>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
