---
const quickLinks = [
  { href: '/projects', label: 'Explore Projects' },
  { href: '/#about', label: 'About Us' },
  { href: '/#contact', label: 'Contact' },
];
---

<footer class="footer">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
      <!-- Brand Column -->
      <div>
        <a href="/" class="inline-block mb-4">
          <img src="/logo-white.svg" alt="GLINT Research" class="h-14 w-auto" />
        </a>
        <p class="text-white/70 max-w-md text-sm leading-relaxed">
          Gastro London Investigative Network for Trainees — empowering gastroenterology trainees across London to collaborate on meaningful research.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="md:text-right">
        <h3 class="footer-title">Quick Links</h3>
        <ul class="space-y-1">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link inline-block md:block">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Sponsors -->
    <div class="border-t border-white/10 py-6 text-center">
      <p class="text-xs text-white/50 uppercase tracking-wider mb-2">SPONSORS</p>
      <p class="text-white/70 text-sm">
        We would like to thank <a href="https://gutscharity.org.uk/" target="_blank" rel="noopener noreferrer" class="font-semibold text-white hover:text-accent transition-colors">GUTS UK</a> for their generous support
      </p>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-white/50 text-sm">
        Made with <span class="text-red-400">&#10084;</span> for gastroenterology research
      </p>

      <!-- Social Links -->
      <div class="flex items-center gap-3">
        <a
          href="https://twitter.com/the_poo_doctor"
          target="_blank"
          rel="noopener noreferrer"
          class="icon-btn"
          aria-label="Follow us on Twitter"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a
          href="mailto:glintresearch@gmail.com"
          class="icon-btn"
          aria-label="Email us"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
