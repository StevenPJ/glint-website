---
interface Props {
  title: string;
  status: 'ongoing' | 'completed' | 'upcoming';
  description: string;
  collaborators?: string;
  slug?: string;
  image?: string;
}

const { title, status, description, collaborators, slug, image } = Astro.props;

const statusColors = {
  ongoing: 'badge-success',
  completed: 'badge-primary',
  upcoming: 'badge-warning',
};

const statusLabels = {
  ongoing: 'Ongoing',
  completed: 'Completed',
  upcoming: 'Coming Soon',
};
---

<article class="card group">
  {image && (
    <div class="aspect-video overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
  )}
  <div class="card-body">
    <div class="flex items-start justify-between gap-4 mb-3">
      <span class={statusColors[status]}>
        {statusLabels[status]}
      </span>
    </div>

    <h3 class="text-xl font-bold text-text mb-2 group-hover:text-primary transition-colors">
      {slug ? (
        <a href={`/projects/${slug}`} class="hover:text-primary">
          {title}
        </a>
      ) : (
        title
      )}
    </h3>

    <p class="text-text-muted mb-4 line-clamp-3">
      {description}
    </p>

    {collaborators && (
      <p class="text-sm text-text-muted mb-4">
        <span class="font-medium">Collaborators:</span> {collaborators}
      </p>
    )}

    {slug && (
      <a
        href={`/projects/${slug}`}
        class="inline-flex items-center text-secondary font-medium hover:text-secondary-dark transition-colors"
      >
        Learn more
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    )}
  </div>
</article>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
