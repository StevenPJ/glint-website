---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

// Fetch all projects from TinaCMS content
const allProjects = await getCollection('projects');

// Sort projects by order
allProjects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

// Separate projects by status
const currentProjects = allProjects.filter(p => p.data.status === 'ongoing' || p.data.status === 'upcoming');
const pastProjects = allProjects.filter(p => p.data.status === 'completed');

// Pre-render all project content
const currentProjectsWithContent = await Promise.all(
  currentProjects.map(async (project) => {
    const { Content } = await render(project);
    return { project, Content };
  })
);

const pastProjectsWithContent = await Promise.all(
  pastProjects.map(async (project) => {
    const { Content } = await render(project);
    return { project, Content };
  })
);

const ITEMS_PER_PAGE = 3;
const currentTotalPages = Math.ceil(currentProjects.length / ITEMS_PER_PAGE);
const pastTotalPages = Math.ceil(pastProjects.length / ITEMS_PER_PAGE);

// Default images for projects (medical/research themed from Unsplash)
const defaultImages: Record<string, string> = {
  'oesophageal-dilatation': 'https://images.unsplash.com/photo-1579684385127-1ef15d508118?w=600&h=450&fit=crop',
  'sustainability-greener-nhs': 'https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?w=600&h=450&fit=crop',
  'baveno-vi-varices': 'https://images.unsplash.com/photo-1559757175-5700dde675bc?w=600&h=450&fit=crop',
  'ibd-transfer-care': 'https://images.unsplash.com/photo-1631815588090-d4bfec5b1ccb?w=600&h=450&fit=crop',
  'duodenoscope-infection': 'https://images.unsplash.com/photo-1582719471384-894fbb16e074?w=600&h=450&fit=crop',
  'uc-reporting-bundle': 'https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=600&h=450&fit=crop',
};

function getProjectImage(projectId: string, customImage?: string): string {
  if (customImage) return customImage;
  return defaultImages[projectId] || 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=600&h=450&fit=crop';
}
---

<BaseLayout
  title="Projects Past & Present - GLINT Research"
  description="Explore GLINT's current, completed, and upcoming gastroenterology research projects across London hospitals."
>
  <!-- Current Projects Section -->
  {currentProjectsWithContent.length > 0 && (
    <section class="section pt-8 md:pt-16" id="current-projects">
      <div class="container max-w-5xl">
        <div class="mb-10">
          <p class="section-label">WHAT CAN YOU GET INVOLVED IN?</p>
          <h2 class="section-title">Current Projects</h2>
        </div>

        <div id="current-projects-list" class="space-y-6">
          {currentProjectsWithContent.map(({ project, Content }, index) => (
            <article
              class="current-project-item bg-surface rounded-2xl p-6 md:p-8 shadow-card"
              data-page={Math.floor(index / ITEMS_PER_PAGE) + 1}
              style={index >= ITEMS_PER_PAGE ? "display: none;" : ""}
            >
              <div class="flex flex-col md:flex-row gap-6 md:gap-8">
                {/* Image */}
                <div class="md:w-1/3 flex-shrink-0">
                  <img
                    src={getProjectImage(project.id, project.data.image)}
                    alt={project.data.title}
                    class="w-full aspect-[4/3] object-cover rounded-xl"
                    loading="lazy"
                  />
                </div>

                {/* Content */}
                <div class="md:w-2/3">
                  {/* Status badges */}
                  <div class="flex flex-wrap items-center gap-2 mb-3">
                    {project.data.recruiting && (
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-700">
                        <span class="w-2 h-2 rounded-full bg-current mr-1.5 animate-pulse"></span>
                        Recruiting Now
                      </span>
                    )}
                    {project.data.status === 'upcoming' && (
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-amber-100 text-amber-700">
                        Coming Soon
                      </span>
                    )}
                    {project.data.status === 'ongoing' && !project.data.recruiting && (
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-700">
                        In Progress
                      </span>
                    )}
                  </div>

                  {/* Title */}
                  <h3 class="text-xl md:text-2xl font-bold text-text mb-3">
                    {project.data.title}
                  </h3>

                  {/* Collaborators */}
                  {project.data.collaborators && (
                    <p class="text-sm text-text-muted mb-3">
                      <span class="font-medium">In collaboration with:</span> {project.data.collaborators}
                    </p>
                  )}

                  {/* Dates */}
                  {project.data.startDate && (
                    <p class="text-sm text-text-muted mb-4">
                      <span class="font-medium">Started:</span> {new Date(project.data.startDate).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}
                    </p>
                  )}

                  {/* Full Description (rendered MDX) */}
                  <div class="prose prose-sm max-w-none text-text-muted mb-6">
                    <Content />
                  </div>

                  {/* CTA */}
                  <a href="/#contact" class="inline-flex items-center gap-2 text-primary font-medium hover:text-primary-dark transition-colors">
                    {project.data.recruiting ? 'Get involved in this project' : 'Contact us for more info'}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        {/* Pagination Controls */}
        {currentTotalPages > 1 && (
          <div id="current-pagination" class="flex justify-center items-center gap-4 mt-10 pt-8 border-t border-gray-200">
            <button
              type="button"
              id="current-prev"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-300 text-text-muted hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
              disabled
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              Previous
            </button>

            <span class="text-text-muted">
              Page <span id="current-page-num">1</span> of <span id="current-total-pages">{currentTotalPages}</span>
            </span>

            <button
              type="button"
              id="current-next"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-300 text-text-muted hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
            >
              Next
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Section Divider -->
  <div class="container max-w-5xl">
    <div class="border-t-2 border-gray-200 my-4"></div>
  </div>

  <!-- Past Projects Section -->
  {pastProjectsWithContent.length > 0 && (
    <section class="section" id="past-projects">
      <div class="container max-w-5xl">
        <div class="mb-10">
          <p class="section-label">OUR TRACK RECORD</p>
          <h2 class="section-title">Successful Past Projects</h2>
          <p class="text-text-muted max-w-2xl">
            Our completed research has been published in peer-reviewed journals and presented at major conferences.
          </p>
        </div>

        <div id="past-projects-list" class="space-y-6">
          {pastProjectsWithContent.map(({ project, Content }, index) => (
            <article
              class="past-project-item bg-surface rounded-2xl p-6 md:p-8 shadow-card"
              data-page={Math.floor(index / ITEMS_PER_PAGE) + 1}
              style={index >= ITEMS_PER_PAGE ? "display: none;" : ""}
            >
              <div class="flex flex-col md:flex-row gap-6 md:gap-8">
                {/* Image */}
                <div class="md:w-1/3 flex-shrink-0">
                  <img
                    src={getProjectImage(project.id, project.data.image)}
                    alt={project.data.title}
                    class="w-full aspect-[4/3] object-cover rounded-xl"
                    loading="lazy"
                  />
                </div>

                {/* Content */}
                <div class="md:w-2/3">
                  {/* Status badge */}
                  <div class="flex flex-wrap items-center gap-2 mb-3">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-700">
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      Published
                    </span>
                  </div>

                  {/* Title */}
                  <h3 class="text-xl md:text-2xl font-bold text-text mb-3">
                    {project.data.title}
                  </h3>

                  {/* Collaborators */}
                  {project.data.collaborators && (
                    <p class="text-sm text-text-muted mb-3">
                      <span class="font-medium">In collaboration with:</span> {project.data.collaborators}
                    </p>
                  )}

                  {/* Dates */}
                  <p class="text-sm text-text-muted mb-4">
                    {project.data.startDate && project.data.endDate && (
                      <>
                        <span class="font-medium">Completed:</span> {new Date(project.data.endDate).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}
                      </>
                    )}
                  </p>

                  {/* Full Description (rendered MDX) */}
                  <div class="prose prose-sm max-w-none text-text-muted mb-6">
                    <Content />
                  </div>

                  {/* Publication Link */}
                  {project.data.publicationUrl && (
                    <a
                      href={project.data.publicationUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-primary font-medium hover:text-primary-dark transition-colors"
                    >
                      Read the publication
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>

        {/* Pagination Controls */}
        {pastTotalPages > 1 && (
          <div id="past-pagination" class="flex justify-center items-center gap-4 mt-10 pt-8 border-t border-gray-200">
            <button
              type="button"
              id="past-prev"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-300 text-text-muted hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
              disabled
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              Previous
            </button>

            <span class="text-text-muted">
              Page <span id="past-page-num">1</span> of <span id="past-total-pages">{pastTotalPages}</span>
            </span>

            <button
              type="button"
              id="past-next"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-300 text-text-muted hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
            >
              Next
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="section">
    <div class="container">
      <div class="cta-section bg-gradient-to-br from-primary to-primary-dark text-white">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: white;">Got a Research Idea?</h2>
          <p class="text-white/90 text-lg mb-6">
            We're always looking for new research ideas from London gastroenterology trainees. Share your proposal and we'll help turn it into a multi-centre study.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/#contact" class="btn btn-white">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Contact Us
            </a>
            <a href="/#contact" class="btn bg-white/10 border-2 border-white/30 hover:bg-white/20" style="color: white;">
              Join Mailing List
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ currentTotalPages, pastTotalPages, ITEMS_PER_PAGE }}>
  // Setup pagination for a section
  function setupPagination(sectionPrefix, totalPages) {
    if (totalPages <= 1) return;

    const pageNum = document.getElementById(`${sectionPrefix}-page-num`);
    const items = document.querySelectorAll(`.${sectionPrefix}-project-item`);
    const section = document.getElementById(`${sectionPrefix}-projects`);

    // Get fresh button references (important for re-initialization)
    let prevBtn = document.getElementById(`${sectionPrefix}-prev`);
    let nextBtn = document.getElementById(`${sectionPrefix}-next`);

    if (!prevBtn || !nextBtn || items.length === 0) return;

    // Store current page in data attribute on section to persist across re-initializations
    let currentPage = parseInt(section?.dataset.currentPage) || 1;

    function updateButtonStates(page) {
      // Get fresh references to buttons in case they were replaced
      const currentPrevBtn = document.getElementById(`${sectionPrefix}-prev`);
      const currentNextBtn = document.getElementById(`${sectionPrefix}-next`);
      if (currentPrevBtn) currentPrevBtn.disabled = page === 1;
      if (currentNextBtn) currentNextBtn.disabled = page === totalPages;
    }

    function showPage(page, shouldScroll = false) {
      // Track which items should show dividers
      let visibleIndex = 0;

      items.forEach((item) => {
        const itemPage = parseInt(item.dataset.page);
        const divider = item.querySelector('.border-t');

        if (itemPage === page) {
          item.style.display = '';
          // Hide divider for first visible item on each page
          if (divider) {
            divider.style.display = visibleIndex === 0 ? 'none' : '';
          }
          visibleIndex++;
        } else {
          item.style.display = 'none';
        }
      });

      currentPage = page;
      if (section) section.dataset.currentPage = page;
      if (pageNum) pageNum.textContent = page;
      updateButtonStates(page);

      // Scroll to top of section when changing pages
      if (shouldScroll && section) {
        const headerOffset = 100; // Account for fixed header
        const elementPosition = section.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth'
        });
      }
    }

    // Define click handlers
    function handlePrevClick(e) {
      e.preventDefault();
      e.stopPropagation();
      if (currentPage > 1) {
        showPage(currentPage - 1, true);
      }
    }

    function handleNextClick(e) {
      e.preventDefault();
      e.stopPropagation();
      if (currentPage < totalPages) {
        showPage(currentPage + 1, true);
      }
    }

    // Clone buttons to remove any existing listeners
    const newPrevBtn = prevBtn.cloneNode(true);
    const newNextBtn = nextBtn.cloneNode(true);
    prevBtn.parentNode.replaceChild(newPrevBtn, prevBtn);
    nextBtn.parentNode.replaceChild(newNextBtn, nextBtn);

    // Add listeners to the new buttons
    newPrevBtn.addEventListener('click', handlePrevClick);
    newNextBtn.addEventListener('click', handleNextClick);

    // Initialize display with correct button states
    showPage(currentPage, false);
  }

  function initPagination() {
    setupPagination('current', currentTotalPages);
    setupPagination('past', pastTotalPages);
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPagination);
  } else {
    initPagination();
  }

  // Re-initialize on Astro view transitions
  document.addEventListener('astro:page-load', initPagination);
</script>

<style>
  /* Style the rendered MDX content */
  .prose h2 {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }
  .prose h3 {
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 0.75rem;
    margin-bottom: 0.25rem;
  }
  .prose p {
    margin-bottom: 0.75rem;
  }
  .prose ul {
    list-style-type: disc;
    list-style-position: inside;
    margin-bottom: 0.75rem;
  }
  .prose ul > li + li {
    margin-top: 0.25rem;
  }
  .prose li {
    color: var(--color-text-muted);
  }
  .prose strong {
    font-weight: 600;
    color: var(--color-text);
  }
  .prose a {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .prose a:hover {
    color: var(--color-primary-dark);
  }
</style>
