---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProjectCard from '../../components/ProjectCard.astro';

// All projects (will be populated from TinaCMS content)
const allProjects = [
  // Ongoing Projects
  {
    title: "Oesophageal Dilatation for Benign Strictures",
    status: "ongoing" as const,
    description: "Multi-centre investigation of endoscopic dilatation effectiveness, guideline adherence, and failure risk factors in benign oesophageal stricture patients. Data collection commenced January 2024; sites still being recruited.",
    collaborators: "YaHGuT Research Group (Yorkshire And Humber Gastroenterology audit/research Trainee network)",
    slug: "oesophageal-dilatation",
  },
  {
    title: "Duodenoscope-Associated Infection Post-ERCP",
    status: "ongoing" as const,
    description: "National multi-centre study examining infection incidence following endoscopic retrograde cholangiopancreatography with reusable duodenoscopes. Currently undergoing write-up.",
    slug: "duodenoscope-infection",
  },
  // Completed Projects
  {
    title: "Sustainability Project: Greener NHS",
    status: "completed" as const,
    description: "Carbon emissions assessment comparing pre-pandemic face-to-face versus pandemic-era virtual gastroenterology clinic appointments. Recently submitted for publication.",
    slug: "sustainability-greener-nhs",
  },
  {
    title: "Quality of Care in Adult IBD Patients",
    status: "completed" as const,
    description: "Poster presentation at BSG Conference, Glasgow, June 2019. Multi-centre study across 16 hospitals examining care quality during patient transfers.",
    slug: "ibd-quality-of-care",
  },
  {
    title: "UC Reporting Proforma Standardization",
    status: "completed" as const,
    description: "Study across 7 London sites with 899 data points examining ulcerative colitis endoscopy reporting standardization. Presented at ECCO, February 2020.",
    slug: "uc-reporting-proforma",
  },
  {
    title: "Transient Elastography Utilization Audit",
    status: "completed" as const,
    description: "Multi-centre audit across 12 hospitals reviewing 828 endoscopies, presented at BASL virtual meeting, September 2020.",
    slug: "transient-elastography-audit",
  },
  // Upcoming Projects
  {
    title: "Liver Research Project",
    status: "upcoming" as const,
    description: "A new liver-focused research initiative currently in development. Details and recruitment information coming soon.",
    slug: "liver-project",
  },
];

const ongoingProjects = allProjects.filter(p => p.status === 'ongoing');
const completedProjects = allProjects.filter(p => p.status === 'completed');
const upcomingProjects = allProjects.filter(p => p.status === 'upcoming');
---

<BaseLayout
  title="Projects - GLINT Research"
  description="View our current, completed, and upcoming gastroenterology research projects across London hospitals."
>
  <Hero
    title="Our Research Projects"
    subtitle="Explore our portfolio of collaborative gastroenterology research initiatives across London."
  />

  <!-- Ongoing Projects -->
  {ongoingProjects.length > 0 && (
    <section class="section bg-background">
      <div class="container">
        <h2 class="section-title text-left">Ongoing Projects</h2>
        <p class="text-text-muted mb-8">
          Active research projects currently recruiting or collecting data.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {ongoingProjects.map((project) => (
            <ProjectCard {...project} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Upcoming Projects -->
  {upcomingProjects.length > 0 && (
    <section class="section bg-white">
      <div class="container">
        <h2 class="section-title text-left">Coming Soon</h2>
        <p class="text-text-muted mb-8">
          Research initiatives in development. Watch this space for recruitment announcements.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {upcomingProjects.map((project) => (
            <ProjectCard {...project} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Completed Projects -->
  {completedProjects.length > 0 && (
    <section class="section bg-background">
      <div class="container">
        <h2 class="section-title text-left">Completed Projects</h2>
        <p class="text-text-muted mb-8">
          Successfully completed research with published outcomes.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {completedProjects.map((project) => (
            <ProjectCard {...project} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Get Involved CTA -->
  <section class="section bg-gradient-to-br from-primary to-secondary">
    <div class="container">
      <div class="max-w-2xl mx-auto text-center text-white">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Got a Research Idea?</h2>
        <p class="text-white/90 text-lg mb-6">
          We're always looking for new research ideas from London gastroenterology trainees. Share your proposal and we'll help turn it into a multi-centre study.
        </p>
        <a href="/get-involved" class="btn bg-white text-primary hover:bg-accent hover:text-primary-dark">
          Submit Your Idea
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
