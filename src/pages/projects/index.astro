---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch all projects from TinaCMS content
const allProjects = await getCollection('projects');

// Sort projects by order
allProjects.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

// Separate projects by status
const recruitingProjects = allProjects.filter(p => p.data.status === 'ongoing' && p.data.recruiting === true);
const ongoingProjects = allProjects.filter(p => p.data.status === 'ongoing' && p.data.recruiting !== true);
const completedProjects = allProjects.filter(p => p.data.status === 'completed');
const upcomingProjects = allProjects.filter(p => p.data.status === 'upcoming');

// Combine recruiting and ongoing for the "Current Projects" section
const currentProjects = [...recruitingProjects, ...ongoingProjects];

// Pagination for completed projects
const ITEMS_PER_PAGE = 6;
const totalPages = Math.ceil(completedProjects.length / ITEMS_PER_PAGE);

const statusColors = {
  ongoing: 'bg-green-100 text-green-700',
  completed: 'bg-blue-100 text-blue-700',
  upcoming: 'bg-amber-100 text-amber-700',
};

const statusLabels = {
  ongoing: 'Ongoing',
  completed: 'Published',
  upcoming: 'Coming Soon',
};
---

<BaseLayout
  title="Projects Past & Present - GLINT Research"
  description="Explore GLINT's current, completed, and upcoming gastroenterology research projects across London hospitals."
>
  <!-- Hero Section -->
  <section class="section pt-8 md:pt-16">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-secondary/10 text-secondary text-sm font-medium mb-6">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          Our Research Portfolio
        </div>

        <!-- Title -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight">
          Projects <span class="text-gradient">Past & Present</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg md:text-xl text-text-muted max-w-2xl mx-auto mb-8">
          Explore our portfolio of collaborative gastroenterology research across London — from ongoing studies you can join to our published work.
        </p>
      </div>
    </div>
  </section>

  <!-- Get Involved / Recruiting Projects Section -->
  {recruitingProjects.length > 0 && (
    <section class="section pt-0">
      <div class="container">
        <div class="text-center mb-10">
          <p class="section-label">GET INVOLVED NOW</p>
          <h2 class="section-title">Projects Recruiting Members</h2>
          <p class="section-subtitle mx-auto">
            These projects are actively recruiting. Join a multi-centre study and contribute to advancing gastroenterology care.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-5xl mx-auto">
          {recruitingProjects.map((project) => (
            <article class="project-card border-2 border-green-200 bg-green-50/30">
              <div class="flex items-start justify-between gap-4 mb-3">
                <span class="badge bg-green-100 text-green-700">
                  <span class="w-2 h-2 rounded-full bg-current mr-1.5 animate-pulse"></span>
                  Recruiting
                </span>
              </div>

              <h3 class="project-title">{project.data.title}</h3>

              {project.data.collaborators && (
                <p class="project-meta">In collaboration with {project.data.collaborators}</p>
              )}

              <p class="project-description">{project.data.shortDescription}</p>

              <div class="mt-4 pt-4 border-t border-green-200">
                <a href="/#contact" class="arrow-link text-green-700">
                  Interested in joining?
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Ongoing Projects (not recruiting) -->
  {ongoingProjects.length > 0 && (
    <section class="section pt-0">
      <div class="container">
        <div class="text-center mb-10">
          <p class="section-label">IN PROGRESS</p>
          <h2 class="section-title">Other Ongoing Projects</h2>
          <p class="section-subtitle mx-auto">
            These projects are currently in progress. Check back soon for updates or contact us for more information.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-5xl mx-auto">
          {ongoingProjects.map((project) => (
            <article class="project-card">
              <div class="flex items-start justify-between gap-4 mb-3">
                <span class={`badge ${statusColors[project.data.status]}`}>
                  {statusLabels[project.data.status]}
                </span>
              </div>

              <h3 class="project-title">{project.data.title}</h3>

              {project.data.collaborators && (
                <p class="project-meta">In collaboration with {project.data.collaborators}</p>
              )}

              <p class="project-description">{project.data.shortDescription}</p>

              <div class="mt-4 pt-4 border-t border-gray-100">
                <a href="/#contact" class="arrow-link">
                  Contact for more info
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Future Projects Section -->
  {upcomingProjects.length > 0 && (
    <section id="future" class="section bg-surface">
      <div class="container">
        <div class="text-center mb-10">
          <p class="section-label">COMING SOON</p>
          <h2 class="section-title">Future Projects</h2>
          <p class="section-subtitle mx-auto">
            Research initiatives in development. Sign up to our mailing list to be notified when recruitment opens.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {upcomingProjects.map((project) => (
            <article class="project-card">
              <div class="flex items-start justify-between gap-4 mb-3">
                <span class={`badge ${statusColors[project.data.status]}`}>
                  {statusLabels[project.data.status]}
                </span>
              </div>

              <h3 class="project-title">{project.data.title}</h3>
              <p class="project-description">{project.data.shortDescription}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Completed Projects Section with Pagination -->
  {completedProjects.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="text-center mb-10">
          <p class="section-label">OUR TRACK RECORD</p>
          <h2 class="section-title">Successful Past Projects</h2>
          <p class="section-subtitle mx-auto">
            Our completed research has been published in peer-reviewed journals and presented at major conferences.
          </p>
        </div>

        <div id="completed-projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
          {completedProjects.map((project, index) => (
            <article
              class="project-card completed-project"
              data-page={Math.floor(index / ITEMS_PER_PAGE) + 1}
              style={index >= ITEMS_PER_PAGE ? "display: none;" : ""}
            >
              <div class="flex items-start justify-between gap-4 mb-3">
                <span class={`badge ${statusColors[project.data.status]}`}>
                  <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {statusLabels[project.data.status]}
                </span>
              </div>

              <h3 class="project-title">{project.data.title}</h3>
              <p class="project-description">{project.data.shortDescription}</p>

              {project.data.publicationUrl && (
                <div class="mt-4 pt-4 border-t border-gray-100">
                  <a
                    href={project.data.publicationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="arrow-link"
                  >
                    Read the publication
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              )}
            </article>
          ))}
        </div>

        <!-- Pagination Controls -->
        {totalPages > 1 && (
          <div id="pagination-controls" class="flex justify-center items-center gap-4 mt-8">
            <button
              id="prev-page"
              class="btn btn-outline disabled:opacity-50 disabled:cursor-not-allowed"
              disabled
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              Previous
            </button>

            <span id="page-info" class="text-text-muted">
              Page <span id="current-page">1</span> of <span id="total-pages">{totalPages}</span>
            </span>

            <button
              id="next-page"
              class="btn btn-outline"
              disabled={totalPages <= 1}
            >
              Next
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="section">
    <div class="container">
      <div class="cta-section bg-gradient-to-br from-primary to-primary-dark text-white">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Got a Research Idea?</h2>
          <p class="text-white/90 text-lg mb-6">
            We're always looking for new research ideas from London gastroenterology trainees. Share your proposal and we'll help turn it into a multi-centre study.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="mailto:glintresearch@gmail.com" class="btn btn-white">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Contact Us
            </a>
            <a href="/#contact" class="btn bg-white/10 text-white border-2 border-white/30 hover:bg-white/20">
              Join Mailing List
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ totalPages, ITEMS_PER_PAGE }}>
  // Client-side pagination for completed projects
  document.addEventListener('DOMContentLoaded', () => {
    let currentPage = 1;
    const prevBtn = document.getElementById('prev-page');
    const nextBtn = document.getElementById('next-page');
    const currentPageSpan = document.getElementById('current-page');
    const projects = document.querySelectorAll('.completed-project');

    function showPage(page) {
      projects.forEach((project) => {
        const projectPage = parseInt(project.dataset.page);
        if (projectPage === page) {
          project.style.display = '';
        } else {
          project.style.display = 'none';
        }
      });

      currentPage = page;
      currentPageSpan.textContent = page;

      prevBtn.disabled = page === 1;
      nextBtn.disabled = page === totalPages;
    }

    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          showPage(currentPage - 1);
        }
      });

      nextBtn.addEventListener('click', () => {
        if (currentPage < totalPages) {
          showPage(currentPage + 1);
        }
      });
    }
  });
</script>
