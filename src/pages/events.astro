---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import EventsPage from '../../tina/pages/EventsPage';
import client from '../../tina/__generated__/client';

const pageResult = await client.queries.eventsPage({ relativePath: 'events.mdx' });
const page = pageResult.data.eventsPage;

const eventsResult = await client.queries.eventConnection({ sort: 'order' });
---

<BaseLayout title={page.seoTitle} description={page.seoDescription ?? ''}>
  <HeroBanner title={page.heroTitle} subtitle={page.heroSubtitle ?? undefined} />
  <EventsPage
    client:load
    data={{ ...pageResult.data, eventConnection: eventsResult.data.eventConnection }}
    query={pageResult.query}
    variables={pageResult.variables}
  />
</BaseLayout>
