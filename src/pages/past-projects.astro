---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import PastProjectsPage from '../../tina/pages/PastProjectsPage';
import client from '../../tina/__generated__/client';

const pageResult = await client.queries.page({ relativePath: 'past-projects.mdx' });
const page = pageResult.data.page;

const publicationsResult = await client.queries.publicationConnection({ sort: 'order' });
---

<BaseLayout title={page.seoTitle} description={page.seoDescription ?? ''}>
  <HeroBanner title={page.heroTitle} subtitle={page.heroSubtitle ?? undefined} />
  <PastProjectsPage
    client:load
    data={{ ...pageResult.data, publicationConnection: publicationsResult.data.publicationConnection }}
    query={pageResult.query}
    variables={pageResult.variables}
  />
</BaseLayout>
