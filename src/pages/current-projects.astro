---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import CurrentProjectsPage from '../../tina/pages/CurrentProjectsPage';
import client from '../../tina/__generated__/client';

const pageResult = await client.queries.page({ relativePath: 'current-projects.mdx' });
const page = pageResult.data.page;

const projectsResult = await client.queries.projectConnection({ sort: 'order' });
---

<BaseLayout title={page.seoTitle} description={page.seoDescription ?? ''}>
  <HeroBanner title={page.heroTitle} subtitle={page.heroSubtitle ?? undefined} />
  <CurrentProjectsPage
    client:load
    data={{ ...pageResult.data, projectConnection: projectsResult.data.projectConnection }}
    query={pageResult.query}
    variables={pageResult.variables}
  />
</BaseLayout>
