---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
---

<BaseLayout
  title="Contact Us | GLINT Research"
  description="Get in touch to join our mailing list, collaborate on research, or learn more about GLINT."
>
  <HeroBanner
    title="Contact Us"
    subtitle="Get in touch to join our mailing list, collaborate on research, or learn more about GLINT."
  />

  <section class="container py-12 md:py-16">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">

      <!-- LEFT: Join Our Network form -->
      <div>
        <h2 class="text-2xl font-semibold font-serif mb-2">Join Our Network</h2>
        <p class="text-muted-foreground mb-6">
          Fill in the form below to join our mailing list and stay updated on GLINT projects and events.
        </p>

        <form action="https://formspree.io/f/xrezokpn" method="POST" class="space-y-5">
          <input type="hidden" name="_subject" value="GLINT Website Contact Form" />

          <!-- Name + Email side by side -->
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="fullName" class="form-label">
                Full Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="fullName"
                name="fullName"
                required
                placeholder="Dr. Jane Smith"
                class="form-input"
              />
            </div>
            <div>
              <label for="email" class="form-label">
                Email Address <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="jane.smith@nhs.net"
                class="form-input"
              />
            </div>
          </div>

          <div>
            <label for="institution" class="form-label">Institution / Hospital</label>
            <input
              type="text"
              id="institution"
              name="institution"
              placeholder="e.g. Guy's and St Thomas' NHS Foundation Trust"
              class="form-input"
            />
          </div>

          <div>
            <label for="areaOfInterest" class="form-label">Area of Interest</label>
            <input
              type="text"
              id="areaOfInterest"
              name="areaOfInterest"
              placeholder="e.g. IBD, Hepatology, Endoscopy"
              class="form-input"
            />
          </div>

          <div>
            <label for="message" class="form-label">Message (Optional)</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Tell us how you'd like to get involved..."
              class="form-input"
            ></textarea>
          </div>

          <button type="submit" class="btn btn-sm btn-primary">
            Submit
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1">
              <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/>
            </svg>
          </button>
        </form>
      </div>

      <!-- RIGHT: Why Join + Connect stacked -->
      <div class="flex flex-col gap-8">
        <!-- Why Join GLINT? -->
        <div class="rounded-xl p-6 lg:p-8" style="background-color: rgba(237, 240, 242, 0.5)">
          <h2 class="text-2xl font-semibold font-serif mb-6">Why Join GLINT?</h2>
          <ul class="space-y-4">
            {[
              'Collaborate on multicentre research projects',
              'Develop your academic portfolio',
              'Network with trainees across London',
              'Access to workshops and educational events',
              'Contribute to quality improvement in gastroenterology',
            ].map((benefit) => (
              <li class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary mt-0.5 shrink-0">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/>
                </svg>
                <span class="text-muted-foreground">{benefit}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Connect With Us -->
        <div class="card-elevated p-6 lg:p-8">
          <h2 class="text-2xl font-semibold font-serif mb-6">Connect With Us</h2>
          <div class="space-y-4">
            <a href="mailto:glint.research@gmail.com" class="flex items-center gap-3 text-muted-foreground hover:text-primary transition-colors">
              <div class="icon-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </div>
              glint.research@gmail.com
            </a>
            <a href="https://twitter.com/GLINT_Research" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-muted-foreground hover:text-primary transition-colors">
              <div class="icon-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </div>
              @GLINT_Research
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
