---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
---

<BaseLayout
  title="Contact Us | GLINT Research"
  description="Get in touch to join our mailing list, collaborate on research, or learn more about GLINT."
>
  <HeroBanner
    title="Contact Us"
    subtitle="Get in touch to join our mailing list, collaborate on research, or learn more about GLINT."
  />

  <section class="container py-12 md:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

      <!-- LEFT: Join Our Network form -->
      <div class="card-elevated p-6 lg:p-8">
        <h2 class="text-2xl font-bold font-serif mb-2">Join Our Network</h2>
        <p class="text-muted-foreground mb-6">
          Fill in the form below to join our mailing list and stay updated on GLINT projects and events.
        </p>

        <form action="https://formspree.io/f/xrezokpn" method="POST" class="space-y-5">
          <input type="hidden" name="_subject" value="GLINT Website Contact Form" />

          <div>
            <label for="fullName" class="form-label">
              Full Name <span class="text-destructive">*</span>
            </label>
            <input
              type="text"
              id="fullName"
              name="fullName"
              required
              placeholder="Dr. Jane Smith"
              class="form-input"
            />
          </div>

          <div>
            <label for="email" class="form-label">
              Email Address <span class="text-destructive">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="jane.smith@nhs.net"
              class="form-input"
            />
          </div>

          <div>
            <label for="institution" class="form-label">Institution / Hospital</label>
            <input
              type="text"
              id="institution"
              name="institution"
              placeholder="e.g. Guy's and St Thomas' NHS Foundation Trust"
              class="form-input"
            />
          </div>

          <div>
            <label for="areaOfInterest" class="form-label">Area of Interest</label>
            <input
              type="text"
              id="areaOfInterest"
              name="areaOfInterest"
              class="form-input"
            />
          </div>

          <div>
            <label for="message" class="form-label">Message (Optional)</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="form-input"
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary w-full">
            Submit
          </button>
        </form>
      </div>

      <!-- RIGHT: Why Join GLINT? sidebar -->
      <div class="card-elevated p-6 lg:p-8" style="background-color: var(--color-accent);">
        <h2 class="text-2xl font-bold font-serif mb-6" style="color: var(--color-accent-foreground);">
          Why Join GLINT?
        </h2>

        <ul class="space-y-4">
          {[
            'Collaborate on multicentre research projects',
            'Develop your academic portfolio',
            'Network with trainees across London',
            'Access to workshops and educational events',
            'Contribute to quality improvement in gastroenterology',
          ].map((benefit) => (
            <li class="flex items-start gap-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="w-5 h-5 mt-0.5 shrink-0"
                style="color: var(--color-primary);"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                  clip-rule="evenodd"
                />
              </svg>
              <span style="color: var(--color-accent-foreground);">{benefit}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Connect With Us -->
    <div class="mt-12 text-center">
      <h2 class="text-2xl font-bold font-serif mb-6">Connect With Us</h2>
      <div class="flex flex-col sm:flex-row justify-center gap-6">

        <a
          href="mailto:glint.research@gmail.com"
          class="flex items-center gap-3 text-foreground hover:text-primary transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-5 h-5"
            aria-hidden="true"
          >
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
          <span>glint.research@gmail.com</span>
        </a>

        <a
          href="https://twitter.com/GLINT_Research"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-foreground hover:text-primary transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-5 h-5"
            aria-hidden="true"
          >
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
          <span>@GLINT_Research</span>
        </a>

      </div>
    </div>
  </section>
</BaseLayout>
