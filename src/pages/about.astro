---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import AboutPage from '../../tina/pages/AboutPage';
import client from '../../tina/__generated__/client';

const pageResult = await client.queries.page({ relativePath: 'about.mdx' });
const page = pageResult.data.page;

const teamResult = await client.queries.teamConnection({ sort: 'order' });
---

<BaseLayout title={page.seoTitle} description={page.seoDescription ?? ''}>
  <HeroBanner title={page.heroTitle} subtitle={page.heroSubtitle ?? undefined} />
  <AboutPage
    client:load
    data={{ ...pageResult.data, teamConnection: teamResult.data.teamConnection }}
    query={pageResult.query}
    variables={pageResult.variables}
  />
</BaseLayout>
