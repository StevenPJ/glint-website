---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PublicationCard from '../components/PublicationCard.astro';

// Publications (will be populated from TinaCMS content)
const publications = [
  {
    title: "Quality of care in adult IBD patients transferring between healthcare providers",
    authors: "GLINT Research Network, Omer F Ahmad, Homira Ayubi, et al.",
    journal: "Frontline Gastroenterology",
    year: 2020,
    link: "https://fg.bmj.com/content/flgastro/early/2020/01/13/flgastro-2019-101347.full.pdf",
    pubType: "journal" as const,
  },
  {
    title: "Implementation of an intervention bundle leads to quality improvement in ulcerative colitis endoscopy reporting",
    authors: "Rawen Kader, Robin J. Dart, Gregory Sebepos-Rogers, et al.",
    journal: "GastroHep",
    year: 2020,
    link: "https://onlinelibrary.wiley.com/doi/abs/10.1002/ygh2.427",
    pubType: "journal" as const,
  },
  {
    title: "Unlocking the benefits of Baveno VI guidance when screening for varices",
    authors: "Michael Colwill, Luke Lake, Ahmed El-Sayed, et al.",
    journal: "Future Healthcare Journal",
    year: 2022,
    link: "https://www.rcpjournals.org/content/futurehosp/early/2022/01/18/fhj.2021-0130",
    pubType: "journal" as const,
    abstract: "80% of 828 reviewed endoscopies did not meet Baveno criteria; potential £48,000 savings identified.",
  },
];

const posters = [
  {
    title: "Quality of care in adult IBD patients",
    authors: "GLINT Research Network",
    journal: "BSG Conference, Glasgow",
    year: 2019,
    pubType: "poster" as const,
    abstract: "Multi-centre study across 16 hospitals.",
  },
  {
    title: "UC reporting proforma standardization",
    authors: "GLINT Research Network",
    journal: "ECCO Conference",
    year: 2020,
    pubType: "poster" as const,
    abstract: "7 London sites, 899 data points collected.",
  },
  {
    title: "Transient elastography utilization audit",
    authors: "GLINT Research Network",
    journal: "BASL Virtual Meeting",
    year: 2020,
    pubType: "poster" as const,
    abstract: "12 hospitals, 828 endoscopies reviewed.",
  },
];

// Group publications by year
const journalPubs = publications.filter(p => p.pubType === 'journal');
---

<BaseLayout
  title="Publications - GLINT Research"
  description="Published research and poster presentations from the GLINT Research Network."
>
  <Hero
    title="Publications"
    subtitle="Our peer-reviewed publications and conference presentations contributing to gastroenterology research."
  />

  <!-- Journal Publications -->
  <section class="section bg-background">
    <div class="container">
      <h2 class="section-title text-left">Journal Publications</h2>
      <p class="text-text-muted mb-8">
        Peer-reviewed articles published in gastroenterology and medical journals.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {journalPubs.map((pub) => (
          <PublicationCard {...pub} />
        ))}
      </div>
    </div>
  </section>

  <!-- Poster Presentations -->
  <section class="section bg-white">
    <div class="container">
      <h2 class="section-title text-left">Conference Presentations</h2>
      <p class="text-text-muted mb-8">
        Poster presentations at national and international gastroenterology conferences.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posters.map((pub) => (
          <PublicationCard {...pub} />
        ))}
      </div>
    </div>
  </section>

  <!-- Research Impact -->
  <section class="section bg-gradient-to-br from-primary to-secondary">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center text-white">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Research Impact</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <div class="text-5xl font-bold mb-2">3+</div>
            <div class="text-white/80">Journal Publications</div>
          </div>
          <div>
            <div class="text-5xl font-bold mb-2">3+</div>
            <div class="text-white/80">Conference Posters</div>
          </div>
          <div>
            <div class="text-5xl font-bold mb-2">20+</div>
            <div class="text-white/80">Contributing Sites</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
