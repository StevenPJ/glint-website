---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import client from '../../tina/__generated__/client';
import HomePage from '../../tina/pages/HomePage';

// Fetch page content from TinaCMS
const result = await client.queries.page({ relativePath: 'home.mdx' });
const page = result.data.page;

// Fetch team members from TinaCMS content
const allTeamMembers = await getCollection('team');

// Sort by order and filter current members
const teamMembers = allTeamMembers
  .filter(m => m.data.memberType === 'current')
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99))
  .map(m => ({
    name: m.data.name,
    role: m.data.role,
    image: m.data.image,
  }));
---

<BaseLayout
  title={page?.seoTitle || "GLINT Research - Empowering Trainees to Drive Research"}
  description={page?.seoDescription || "The Gastro London Investigative Network for Trainees (GLINT) enables gastroenterology trainees across London to collaborate and produce meaningful results for patients."}
>
  <HomePage
    client:load
    data={result.data}
    query={result.query}
    variables={result.variables}
    teamMembers={teamMembers}
  />
</BaseLayout>
