# Site URL (your production URL)
SITE_URL=https://glintresearch.com

# TinaCMS Cloud credentials (get from app.tina.io)
PUBLIC_TINA_CLIENT_ID=your_client_id_here
TINA_TOKEN=your_token_here

# Formspree endpoint (get from formspree.io)
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# MailerLite (get from mailerlite.com)
PUBLIC_MAILERLITE_FORM_ID=your_form_id
